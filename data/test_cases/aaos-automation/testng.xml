<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="AAOS UI Automation Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.aaos.automation.listeners.TestListener"/>
    </listeners>

    <!-- Navigation Tests -->
    <test name="Navigation Tests">
        <classes>
            <class name="com.aaos.automation.tests.NAID_NEW_001_NavigationAppLauncherToBluetoothTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_002_SpotifyLaunchAndReturnHomeTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_003_NavigationToSettingsNotificationsTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_007_SettingsMultipleMenuNavigationTest"/>
        </classes>
    </test>

    <!-- Application Launch Tests -->
    <test name="Application Launch Tests">
        <classes>
            <class name="com.aaos.automation.tests.NAID_NEW_004_ApplicationLaunchSpotifyTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_005_ApplicationLaunchPhoneTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_006_ApplicationLaunchSMSTest"/>
        </classes>
    </test>

    <!-- Gesture Tests -->
    <test name="Gesture Tests">
        <classes>
            <class name="com.aaos.automation.tests.NAID_NEW_008_DragAndDropTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_009_SwipeTest"/>
            <class name="com.aaos.automation.tests.NAID_NEW_010_DoubleTapTest"/>
        </classes>
    </test>

</suite>
